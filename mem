#!/usr/bin/env python3
"""mem — shared memory search across AI coding agents. Read-only: no copying, no merging, no network.
mem — 多个 AI 编码工具之间共享记忆。只读检索，不复制、不合并、不联网。

Config: ~/.config/mem/config.json   Aliases: ~/.config/mem/aliases.tsv
Language: MEM_LANG=zh|en (default: follows system language)
"""
import glob, json, os, re, shutil, subprocess, sys, time

VERSION = "1.1.0"
H = os.path.expanduser("~")
CONF_DIR = os.environ.get("MEM_CONFIG_DIR", f"{H}/.config/mem")
CONF = f"{CONF_DIR}/config.json"
ALIAS_FILE = os.environ.get("MEM_ALIASES", f"{CONF_DIR}/aliases.tsv")

def detect_zh():
    v = os.environ.get("MEM_LANG", "").lower()
    if v: return v.startswith("zh")
    for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(k, "")
        if v and v not in ("C", "POSIX", "C.UTF-8"): return v.lower().startswith("zh")
    if sys.platform == "darwin":
        try:
            r = subprocess.run(["defaults", "read", "-g", "AppleLanguages"], capture_output=True, text=True, timeout=2)
            return '"zh' in r.stdout.split(",")[0]
        except Exception: pass
    return False

ZH = detect_zh()
def L(zh, en): return zh if ZH else en

# Public default locations of each agent (from each tool's docs / install layout, not user-specific)
REGISTRY = {
    "claude":   {"memory": ["~/.claude/projects/*/memory"], "instructions": "~/.claude/CLAUDE.md", "allow": "claude"},
    "codex":    {"memory": ["~/.codex/memories"],           "instructions": "~/.codex/AGENTS.md"},
    "zcode":    {"memory": ["~/.zcode/cli/memories/projects"], "instructions": "~/.zcode/AGENTS.md"},
    "grok":     {"memory": ["~/.grok/memory-v2", "~/.grok/memory"], "instructions": "~/.grok/AGENTS.md", "allow": "grok"},
    "opencode": {"memory": [],                              "instructions": "~/.config/opencode/AGENTS.md"},
}

UNCONFIGURED = L("""mem 尚未配置。不要自己猜要共享哪些工具。

先问主人：这台机器上有哪几个 AI 工具需要共享记忆？
  已知可选：{known}
  其他工具也可以，用 --path 名字=记忆目录 指定。

拿到回答后运行：
  mem init --agents claude,codex,...
""", """mem is not configured yet. Do not guess which agents to share.

Ask the owner first: which AI agents on this machine should share memory?
  Known: {known}
  Others work too, via --path name=memory_dir.

Once you have the answer, run:
  mem init --agents claude,codex,...
""")

BLOCK_ZH = """<!-- mem:begin -->
## 跨工具共享记忆

- 主人问起过去的事，都是在调记忆，直接跑 `mem search 关键词`，不用先问要不要查，也不要回答"我看不到之前的对话"。常见说法：
  - "你还记得……吗""我之前那个……的对话""上次我们……""以前是不是……"
  - "我们当时怎么定的""这个坑以前踩过吗""之前那个方案是什么"
- 主人点名某个工具，比如"去 Codex 那边找一下……""看看 Grok 记了什么"，就加 `--agent codex` 或 `--agent grok` 只搜那一家。
- 不要直接 cat 或 Read 各工具的记忆目录，统一走 mem。
- 如果 `mem` 提示尚未配置：先问主人这台机器上有哪几个 AI 工具要共享记忆，拿到回答再跑 `mem init --agents ...`。不要自己猜。
- 看命中内容用 `mem show <路径> --section '<标题>'`。大文件只给大纲，按节读。
- 库有多大、在哪里，跑 `mem map` 现查，不要凭印象判断。
- 怀疑索引落后于最新会话，跑 `mem recent --days 7 词`。
- 换词两轮（中英文都试过）仍然 0 命中，就是记忆里没有，如实说，不要接着猜。
- 记忆是线索不是事实：端口、地址、版本、文件位置这类会变的信息，用之前先核实。
- 只写本工具自己的记忆目录，一条一个文件，写完在本库索引里加一行指针。不要改别的工具的记忆文件，有些工具会整体重生成，你写进去的会丢。
<!-- mem:end -->"""

BLOCK_EN = """<!-- mem:begin -->
